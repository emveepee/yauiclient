#!/usr/bin/make -f
# debian/rules — multi-binary build for yauiclient
#
# Builds three binary packages from one source by configuring CMake three
# times into separate build dirs, then dispatching files to per-package
# install trees:
#
#   yauiclient-x11             X11 + bundled libmpv      -> build/x11
#   yauiclient-wayland         Wayland + bundled libmpv  -> build/wayland
#   yauiclient-wayland-system  Wayland + system libmpv2  -> build/wayland-sys
#
# Bundled flavours copy the libmpv runtime tarball contents from sdk/lib/
# into /usr/lib/yauiclient/lib/. The system flavour skips bundling and
# Depends: libmpv2 from the archive.

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# GLFW prefix - tools/build-deb.sh builds GLFW (3.4+) from source into here
# before invoking dpkg-buildpackage, because Debian 12 (bookworm) only ships
# GLFW 3.3.8 in main and bookworm-backports doesn't carry GLFW at all.
# YAUI_GLFW_PREFIX is exported by build-deb.sh; if running dpkg-buildpackage
# directly without the wrapper, default to the same path.
GLFW_PREFIX = $(if $(YAUI_GLFW_PREFIX),$(YAUI_GLFW_PREFIX),$(CURDIR)/glfw-prefix)

# Tell the linker where to find libmpv's siblings (FFmpeg 8, libplacebo 360,
# libdav1d 6, etc.) when resolving libmpv.so's NEEDED entries at link time.
# -Wl,-rpath-link adds the dir to the LINK-TIME resolution path WITHOUT
# baking it into the binary's rpath - the rpath itself stays
# $ORIGIN/../lib/yauiclient/lib (set by CMakeLists.txt under
# YAUI_DEB_LAYOUT=ON), pointing at the bundled libs we install.
# This applies to all three CMake invocations because dh_auto_build / our
# explicit cmake --build call respects the env-injected LDFLAGS.
#
# --disable-new-dtags forces the linker to emit DT_RPATH instead of
# DT_RUNPATH. The difference matters at runtime: DT_RPATH lookups apply
# to BOTH the binary AND its NEEDED libraries (so libmpv can find its
# own NEEDED libs like libavcodec.so.62 via yauiclient's rpath), while
# DT_RUNPATH only applies to the binary itself - libmpv would then need
# its own rpath to find its siblings, which our prebuilt libmpv doesn't
# have, leading to "cannot open shared object" errors at startup.
# (yauiclient-wayland-system links against system libmpv2 which has the
# system loader path, so this flag is harmless there.)
export DEB_LDFLAGS_MAINT_APPEND = -L$(CURDIR)/sdk/lib -Wl,-rpath-link=$(CURDIR)/sdk/lib -L$(GLFW_PREFIX)/lib -Wl,-rpath-link=$(GLFW_PREFIX)/lib -Wl,--disable-new-dtags

include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/buildflags.mk

SDK_DIR     = $(CURDIR)/sdk

# Per-flavour build directories
BUILD_X11   = build/x11
BUILD_WL    = build/wayland
BUILD_WLSYS = build/wayland-sys

# Per-flavour install staging directories (CMake DESTDIR target)
STAGE_X11   = $(CURDIR)/$(BUILD_X11)/install
STAGE_WL    = $(CURDIR)/$(BUILD_WL)/install
STAGE_WLSYS = $(CURDIR)/$(BUILD_WLSYS)/install

# Per-package install trees
PKG_X11     = debian/yauiclient-x11
PKG_WL      = debian/yauiclient-wayland
PKG_WLSYS   = debian/yauiclient-wayland-system

# Bundle directories (only for the two bundled flavours)
BUNDLE_X11  = $(PKG_X11)/usr/lib/yauiclient/lib
BUNDLE_WL   = $(PKG_WL)/usr/lib/yauiclient/lib

# Common CMake flags shared by all three flavours
CMAKE_COMMON = -DCMAKE_BUILD_TYPE=Release \
               -DCMAKE_INSTALL_PREFIX=/usr \
               -DCMAKE_PREFIX_PATH=$(GLFW_PREFIX) \
               -G Ninja

# Bundled-flavour libraries to copy from sdk/lib/. Each pattern must match
# at least one file or the install step fails loudly (better than silently
# shipping a partial bundle).
BUNDLE_PATTERNS = libmpv.so libmpv.so.* \
                  libavcodec.so.* libavformat.so.* libavutil.so.* \
                  libavfilter.so.* libswresample.so.* libswscale.so.* \
                  libplacebo.so.* libdisplay-info.so.* \
                  libjpeg.so.62* libluajit-5.1.so.2* libdav1d.so.6*

%:
	dh $@

# ---------------------------------------------------------------------------
# Configure: three CMake invocations, three build dirs
# ---------------------------------------------------------------------------
override_dh_auto_configure:
	# yauiclient-x11: X11 + bundled libmpv
	cmake -B $(BUILD_X11) -S . $(CMAKE_COMMON) \
	  -DYAUI_WAYLAND=OFF \
	  -DYAUI_DEB_LAYOUT=ON \
	  -DLIBMPV_SDK_DIR=$(SDK_DIR) \
	  -DYAUICLIENT_USE_SYSTEM_MPV=OFF
	# yauiclient-wayland: Wayland + bundled libmpv
	cmake -B $(BUILD_WL) -S . $(CMAKE_COMMON) \
	  -DYAUI_WAYLAND=ON \
	  -DYAUI_DEB_LAYOUT=ON \
	  -DLIBMPV_SDK_DIR=$(SDK_DIR) \
	  -DYAUICLIENT_USE_SYSTEM_MPV=OFF
	# yauiclient-wayland-system: Wayland + system libmpv2
	cmake -B $(BUILD_WLSYS) -S . $(CMAKE_COMMON) \
	  -DYAUI_WAYLAND=ON \
	  -DYAUI_DEB_LAYOUT=OFF \
	  -DYAUICLIENT_USE_SYSTEM_MPV=ON

# ---------------------------------------------------------------------------
# Build: three Ninja builds in parallel
# ---------------------------------------------------------------------------
override_dh_auto_build:
	cmake --build $(BUILD_X11)   --parallel
	cmake --build $(BUILD_WL)    --parallel
	cmake --build $(BUILD_WLSYS) --parallel

# yauiclient has no test suite. Without this override, dh_auto_test would
# try to find a build dir to run tests in - and we have three, none with
# any tests defined - causing a failure or undefined behavior. Skip.
override_dh_auto_test:

# ---------------------------------------------------------------------------
# Install: stage each build into its own DESTDIR, then dispatch
# ---------------------------------------------------------------------------
override_dh_auto_install:
	# Stage each build into its own install tree under build/<flavour>/install
	DESTDIR=$(STAGE_X11)   cmake --install $(BUILD_X11)
	DESTDIR=$(STAGE_WL)    cmake --install $(BUILD_WL)
	DESTDIR=$(STAGE_WLSYS) cmake --install $(BUILD_WLSYS)

	# Dispatch the binary into each package
	install -D -m 0755 $(STAGE_X11)/usr/bin/yauiclient   $(PKG_X11)/usr/bin/yauiclient
	install -D -m 0755 $(STAGE_WL)/usr/bin/yauiclient    $(PKG_WL)/usr/bin/yauiclient
	install -D -m 0755 $(STAGE_WLSYS)/usr/bin/yauiclient $(PKG_WLSYS)/usr/bin/yauiclient

	# Bundle libmpv runtime into the two bundled flavours
	mkdir -p $(BUNDLE_X11) $(BUNDLE_WL)
	set -e; \
	for pat in $(BUNDLE_PATTERNS); do \
	    found=0; \
	    for f in $(SDK_DIR)/lib/$$pat; do \
	        if [ -e "$$f" ] || [ -L "$$f" ]; then \
	            cp -P "$$f" $(BUNDLE_X11)/; \
	            cp -P "$$f" $(BUNDLE_WL)/; \
	            found=1; \
	        fi; \
	    done; \
	    if [ $$found -eq 0 ]; then \
	        echo "ERROR: no files matched pattern '$$pat' in $(SDK_DIR)/lib/"; \
	        exit 1; \
	    fi; \
	done

	# Bundle the locally-built GLFW into ALL three flavours. yauiclient
	# is linked against this libglfw, not against the system libglfw3 (which
	# on Debian 12 is only 3.3.8 anyway, missing the 3.4 features we need).
	# The bundle into yauiclient-wayland-system is intentional - that flavour
	# uses the system libmpv2 but still uses our locally-built GLFW.
	mkdir -p $(PKG_WLSYS)/usr/lib/yauiclient/lib
	set -e; \
	for pat in libglfw.so libglfw.so.3 libglfw.so.3.*; do \
	    found=0; \
	    for f in $(GLFW_PREFIX)/lib/$$pat; do \
	        if [ -e "$$f" ] || [ -L "$$f" ]; then \
	            cp -P "$$f" $(BUNDLE_X11)/; \
	            cp -P "$$f" $(BUNDLE_WL)/; \
	            cp -P "$$f" $(PKG_WLSYS)/usr/lib/yauiclient/lib/; \
	            found=1; \
	        fi; \
	    done; \
	    if [ $$found -eq 0 ]; then \
	        echo "ERROR: no files matched GLFW pattern '$$pat' in $(GLFW_PREFIX)/lib/"; \
	        echo "       Did tools/build-deb.sh build GLFW first?"; \
	        exit 1; \
	    fi; \
	done

	# Bundle libfmt.so.9 from the build host. yauiclient links libfmt
	# directly (its SONAME 'libfmt.so.9' must be available on every target
	# distro). libfmt is .9 on bookworm, .8 on jammy, .11 on questing/26.04,
	# .7 on bullseye - bundling decouples the .deb from any specific
	# distro's libfmt SONAME, just as we already do for libjpeg/libfmt in
	# the legacy build.
	#
	# libjpeg.so.62 is already bundled via BUNDLE_PATTERNS (it's in the
	# SDK runtime tarball) so we don't repeat it here.
	set -e; \
	for pat in libfmt.so.9 libfmt.so.9.*; do \
	    found=0; \
	    for f in /usr/lib/x86_64-linux-gnu/$$pat /usr/lib/$$pat; do \
	        if [ -e "$$f" ] || [ -L "$$f" ]; then \
	            cp -P "$$f" $(BUNDLE_X11)/; \
	            cp -P "$$f" $(BUNDLE_WL)/; \
	            cp -P "$$f" $(PKG_WLSYS)/usr/lib/yauiclient/lib/; \
	            found=1; \
	        fi; \
	    done; \
	    if [ $$found -eq 0 ]; then \
	        echo "ERROR: no system file matched '$$pat' in /usr/lib/x86_64-linux-gnu/"; \
	        echo "       libfmt-dev should be installed"; \
	        exit 1; \
	    fi; \
	done

	# Install desktop entries (per-flavour so the menu shows the right one)
	install -D -m 0644 debian/yauiclient-x11.desktop \
	  $(PKG_X11)/usr/share/applications/com.pinstripe.yauiclient.desktop
	install -D -m 0644 debian/yauiclient-wayland.desktop \
	  $(PKG_WL)/usr/share/applications/com.pinstripe.yauiclient.desktop
	install -D -m 0644 debian/yauiclient-wayland.desktop \
	  $(PKG_WLSYS)/usr/share/applications/com.pinstripe.yauiclient.desktop

# ---------------------------------------------------------------------------
# shlibdeps: bundled flavours look in their own bundle dir; system flavour
# uses default search path so libmpv2 resolves to the archive package.
# ---------------------------------------------------------------------------
override_dh_shlibdeps:
	dh_shlibdeps -pyauiclient-x11 \
	  -l$(CURDIR)/$(BUNDLE_X11) \
	  -- --ignore-missing-info -xlibglfw3 -xlibfmt9 -xlibjpeg62-turbo
	dh_shlibdeps -pyauiclient-wayland \
	  -l$(CURDIR)/$(BUNDLE_WL) \
	  -- --ignore-missing-info -xlibglfw3 -xlibfmt9 -xlibjpeg62-turbo
	dh_shlibdeps -pyauiclient-wayland-system \
	  -l$(CURDIR)/$(PKG_WLSYS)/usr/lib/yauiclient/lib \
	  -- --ignore-missing-info -xlibglfw3 -xlibfmt9 -xlibjpeg62-turbo

# ---------------------------------------------------------------------------
# dwz: the bundled .so files come from external builds with DWARF already
# processed; dh_dwz fails on them with 'no debug info found'. Skip the
# bundle path while still letting dh_dwz process the yauiclient binary.
# ---------------------------------------------------------------------------
override_dh_dwz:
	dh_dwz -X /usr/lib/yauiclient/lib/

# ---------------------------------------------------------------------------
# strip: keep -dbgsym off for bundled libs so their build IDs don't collide
# with the real upstream packages a user might have installed elsewhere.
# ---------------------------------------------------------------------------
override_dh_strip:
	dh_strip --no-automatic-dbgsym

# ---------------------------------------------------------------------------
# Clean: nuke all three build dirs
# ---------------------------------------------------------------------------
override_dh_auto_clean:
	rm -rf build/
